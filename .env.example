# =============================================================================
# Pluto -- backend configuration
# Copy to .env and fill in. Never commit .env.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=Pluto Agent
# development | staging | production. Production refuses to start with insecure settings.
ENVIRONMENT=development
DEBUG=False
# text (human readable) | json (for log aggregators)
LOG_FORMAT=text

# --- Security (REQUIRED in production) ---------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=10080
# Encrypts Gmail OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Comma-separated browser origins allowed to call the API (never "*")
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
# Anonymous, short-lived sessions from the "Continue as Guest" button
ALLOW_GUEST_ACCESS=true

# --- Rate limiting & uploads -------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
MAX_UPLOAD_MB=20

# --- LLM provider ------------------------------------------------------------
# google | openai | anthropic | groq | openrouter | ollama
# Leave blank to auto-detect from whichever key is set.
LLM_PROVIDER=google
LLM_MODEL=gemini-flash-lite-latest
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Provider-specific keys (optional; each is only ever sent to its own provider)
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# Optional stronger model for the code-review agent
# CRITIC_MODEL=

# --- Embeddings / vector store -----------------------------------------------
# Embeddings follow the server's provider (Google, OpenAI) or fall back to local ONNX.
EMBEDDING_MODEL=text-embedding-3-small
# GOOGLE_EMBEDDING_API_KEY=
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=documents

# --- Redis (chat memory, rate limits; in-memory fallback if unavailable) -----
REDIS_URL=redis://localhost:6379/0

# --- PostgreSQL (accounts, facts, Gmail tokens, audit log) -------------------
# Either a URL...
POSTGRES_URL=postgresql://pluto:change-me@localhost:5432/pluto
# ...or discrete settings (used when POSTGRES_URL is empty), also read by docker compose:
POSTGRES_USER=pluto
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pluto
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Google sign-in ("Sign in with Google") ----------------------------------
# OAuth client ID (public). Tokens issued to any other client are rejected.
GOOGLE_CLIENT_ID=
# Only needed for the redirect sign-in fallback; stays on the server.
GOOGLE_CLIENT_SECRET=

# --- Gmail integration -------------------------------------------------------
GMAIL_WEB_CLIENT_ID=
GMAIL_WEB_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/gmail/callback
SCOPES=https://www.googleapis.com/auth/gmail.readonly
