# ============================================================================
# Universal LLM Provider Configuration
# ============================================================================
# Supported: google, openai, anthropic, groq, openrouter, ollama
# Leave blank to automatically detect from your API key!
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash

# Paste your API key here (auto-detected):
LLM_API_KEY=your_api_key_here

# Provider-specific keys (optional alternatives):
# GOOGLE_API_KEY=your_gemini_key_here
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GROQ_API_KEY=your_groq_key_here
# OPENROUTER_API_KEY=your_openrouter_key_here

# Generation parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ============================================================================
# Application Settings
# ============================================================================
APP_NAME=Pluto Agent
DEBUG=False

# ============================================================================
# Vector Database (ChromaDB)
# ============================================================================
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=documents

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=

# ============================================================================
# PostgreSQL Configuration
# ============================================================================
POSTGRES_URL=postgresql://postgres:password@localhost:5432/agent_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# ============================================================================
# Gmail Integration & Google OAuth (Optional)
# ============================================================================
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=./token.json
SCOPES=https://www.googleapis.com/auth/gmail.readonly

# Google OAuth (for Google Login & Gmail integration)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
